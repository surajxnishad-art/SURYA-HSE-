# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configurable AI models (verified active Gemini models)
AI_TEXT_MODEL="gemini-4-hydrogen"
AI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# Optional initial admin password (leave blank to use first-run inline admin setup)
ADMIN_BOOTSTRAP_PASSWORD=
